<%- include('includes/head') %>
    <%- include('includes/nav') %>
        <div class="container">
            <div class="row">
                <div class="col-lg-2"></div>

                <div class="col-lg-8 my-3">
                    <h1 class="text-center">CADASTRO CONTATO</h1>
                    <p class="text-center lead">Preencha os dados para cadastrar um novo contato</p>
                            <%- include('includes/messages') %>
                    <div class="row">
                        <div class="col my-3">
                           <% if(contato._id) { %>
                            <form action="/contato/update/<%= contato._id %>" method="POST">
                                <% } else { %>
                                    <form action="/contato/register" method="POST">
                                <% } %>
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <div class="form-group">
                                    <label for="nome">Nome</label>
                                    <input value="<%= contato.nome %>" type="text" class="form-control" id="nome" name="nome"
                                        placeholder="Digite seu nome">
                                </div>
                                <div class="form-group">
                                    <label for="sobrenome">Sobrenome</label>
                                    <input value="<%= contato.sobrenome %>" type="text" class="form-control" id="sobrenome" name="sobrenome"
                                        placeholder="Digite seu sobrenome">
                                </div>
                                <div class="form-group">
                                    <label for="email">Email</label>
                                    <input value="<%= contato.email %>" type="email" class="form-control" id="email" name="email"
                                        placeholder="Digite seu email">
                                </div>
                                <div class="form-group">
                                    <label for="telefone">Telefone</label>
                                    <input value="<%= contato.telefone %>" type="text" class="form-control" id="telefone" name="telefone"
                                        placeholder="Digite seu telefone">
                                </div>
                                <button type="submit" class="btn btn-primary">Cadastrar</button>
                            </form>
                        </div>

                    </div>

                </div>

                <div class="col-lg-2"></div>
            </div>
        </div>


            <%- include('includes/footer') %>