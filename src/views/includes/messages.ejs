<% if (errors.length > 0) { %>
    <div class="row">
        <div class="col my-3">
            <% errors.forEach(function(error){ %>
                <div class="alert-danger"><%= error %></div>
            <% }) }%>
        </div>
    </div>
</div>


<% if (success.length > 0) { %>
    <div class="row">
        <div class="col my-3">
            <% success.forEach(function(message){ %>
                <div class="alert-success"><%= message %></div>
            <% }) }%>
        </div>
    </div>
