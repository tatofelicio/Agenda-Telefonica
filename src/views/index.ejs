<%- include('includes/head') %>
    <%- include('includes/nav') %>
        <div class="container">
            <div class="row">
                <div class="col-lg-2"></div>

                <div class="col-lg-8 my-3">
                    <h1 class="text-center">Agenda</h1>
                    <p class="text-center lead">Seus contatos estão abaixo</p>


                    <div class="responsive-table">
                        <table class="table my-3">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>Sobrenome</th>
                                    <th>Telefone</th>
                                    <th>E-mail</th>
                                </tr>
                            </thead>
                            <% contatos.forEach(contato=> { %>
                                <tr>
                                    <td>
                                        <%= contato.nome %>
                                    </td>
                                    <td>
                                        <%= contato.sobrenome %>
                                    </td>
                                    <td>
                                        <%= contato.telefone %>
                                    </td>
                                    <td>
                                        <%= contato.email %>
                                    </td>
                                    <td class="mr-2">
                                        <a href="/contato/<%= contato._id %>" class="btn btn-primary btn-sm">Editar</a>
                                        <a href="/contato/delete/<%= contato._id %>"
                                            class="btn btn-danger btn-sm "
                                            onclick="return confirm('Tem certeza que deseja apagar o contato <%= contato.nome %>? Esta ação não pode ser desfeita.');">
                                            Excluir</a>
                                    </td>
                                </tr>
                                <% }) %>
                        </table>
                    </div>

                </div>
            </div>
        </div>
        <%- include('includes/messages') %>

            <%- include('includes/footer') %>